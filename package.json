{
  "name": "pixelcli",
  "version": "0.1.0",
  "description": "One terminal chat UI for Anthropic, DeepSeek, OpenAI and Gemini. Switch model mid-conversation without losing the thread.",
  "type": "module",
  "bin": {
    "pixelcli": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node dist/cli.js",
    "start": "node dist/cli.js",
    "prepare": "node scripts/build.mjs",
    "test": "PIXELCLI_CONFIG_DIR=\"$(mktemp -d)\" node --import ./scripts/register.mjs --test test/keys.test.jsx test/stream.test.mjs"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "ink-testing-library": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpixel04/pixelcli.git"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
